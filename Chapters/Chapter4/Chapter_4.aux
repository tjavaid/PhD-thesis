\@writefile{lot}{\contentsline {table}{\numberline {6.3}{\ignorespaces  MC simulation datasets used for the signal processes predicted by the SM for m(H)=125.0$\GeV $ (${\rm  Z}$ stands for ${\rm  Z}$, ${\rm  Z}^*$, $\gamma ^*$). The cross sections do not include the ZZ and $4\ell $ branching ratios. In the SM, the branching ratio ${\rm  H} \rightarrow {\rm  Z}{\rm  Z}\rightarrow 4\ell $ is 1.247$\times 10^{-4}$ for m(H)=125.0 $\GeV $.\relax }}{67}{table.caption.186}}
\newlabel{tab:MCsamplesSig}{{6.3}{67}{MC simulation datasets used for the signal processes predicted by the SM for m(H)=125.0$\GeV $ (${\rm Z}$ stands for ${\rm Z}$, ${\rm Z}^*$, $\gamma ^*$). The cross sections do not include the ZZ and $4\ell $ branching ratios. In the SM, the branching ratio ${\rm H} \rightarrow {\rm Z}{\rm Z}\rightarrow 4\ell $ is 1.247$\times 10^{-4}$ for m(H)=125.0 $\GeV $.\relax }{table.caption.186}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.4}{\ignorespaces  MC simulation datasets used for the background processes (${\rm  Z}$ stands for ${\rm  Z}$, ${\rm  Z}^*$, $\gamma ^*$); In MC samples with label ``t/u channels only'' only the t/u channels are simulated in the $qq \to 4\ell $ process and these samples are used for the $Z \to 4\ell $ analysis. The ``t/u channels only'' samples have lower cut in $m_{ll}$ of 1 GeV, while all other $qq \to ZZ$ and $gg \to ZZ$ samples have lower cut in $m_{ll}$ of 4 GeV. In case of the $gg \to ZZ$ background, the overall NLO k-factor of 2.66 is included, as discussed in Section~\ref  {sec:EventsBackgrounds}.\relax }}{68}{table.caption.187}}
\newlabel{tab:MCsamplesBkg}{{6.4}{68}{MC simulation datasets used for the background processes (${\rm Z}$ stands for ${\rm Z}$, ${\rm Z}^*$, $\gamma ^*$); In MC samples with label ``t/u channels only'' only the t/u channels are simulated in the $qq \to 4\ell $ process and these samples are used for the $Z \to 4\ell $ analysis. The ``t/u channels only'' samples have lower cut in $m_{ll}$ of 1 GeV, while all other $qq \to ZZ$ and $gg \to ZZ$ samples have lower cut in $m_{ll}$ of 4 GeV. In case of the $gg \to ZZ$ background, the overall NLO k-factor of 2.66 is included, as discussed in Section~\ref {sec:EventsBackgrounds}.\relax }{table.caption.187}{}}
