\@writefile{lot}{\contentsline {table}{\numberline {6.1}{\ignorespaces  The number of estimated events from simulation, and number of observed candidates in data, after final inclusive selection in the measurement range $50 < m_{4\ell } < 105 \GeV $ for the $Z\rightarrow 4\ell $ (s-channel $\ensuremath  {\mathrm  {q}}\ensuremath  {\mathrm  {\overline  {q}}}\to \mathrm  {Z}\mathrm  {Z}$) measurements. The s-channel of the $\ensuremath  {\mathrm  {q}}\ensuremath  {\mathrm  {\overline  {q}}}\to \mathrm  {Z}\mathrm  {Z}^* \to 4\ell $ process is considered as signal, while the other processes are considered as backgrounds. Contributions from s-, t- and u-channels in the $\ensuremath  {\mathrm  {q}}\ensuremath  {\mathrm  {\overline  {q}}}\to \mathrm  {Z}\mathrm  {Z}\to 4\ell $ process, as well as $\mathrm  {g}\mathrm  {g}\to \mathrm  {Z}\mathrm  {Z}$ process are estimated from Monte Carlo simulation, while $\mathrm  {Z}+X$ background is estimated from data. \relax }}{149}{table.caption.431}}
\newlabel{tab:EventYieldsZ4l}{{6.1}{149}{The number of estimated events from simulation, and number of observed candidates in data, after final inclusive selection in the measurement range $50 < m_{4\ell } < 105 \GeV $ for the $Z\rightarrow 4\ell $ (s-channel $\Pq \Paq \to \Z \Z $) measurements. The s-channel of the $\Pq \Paq \to \Z \Z ^* \to 4\ell $ process is considered as signal, while the other processes are considered as backgrounds. Contributions from s-, t- and u-channels in the $\Pq \Paq \to \Z \Z \to 4\ell $ process, as well as $\Pg \Pg \to \Z \Z $ process are estimated from Monte Carlo simulation, while $\Z +X$ background is estimated from data. \relax }{table.caption.431}{}}
