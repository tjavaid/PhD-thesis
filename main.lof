\contentsline {subfigure}{\numberline {(d)}{\ignorespaces {$|\qopname \relax o{cos}\theta ^{*}|$}}}{124}{figure.caption.808}
\contentsline {subfigure}{\numberline {(e)}{\ignorespaces {N(jets)}}}{124}{figure.caption.808}
