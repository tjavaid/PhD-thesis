\@writefile{lof}{\contentsline {figure}{\numberline {6.27}{\ignorespaces Differential fiducial cross section results for $\ensuremath  {p_T}({\rm  H})$ (top left), $|y({\rm  H})|$ (top right), $p_T$ of leading jet (bottom left) and N(jets) (bottom right) in $\ensuremath  {\mathrm  {H}\to 4\ell }$ using full Run 2 CMS data and comparison with the theoretical predictions. Systematic uncertainty is indicated by red bars and black bars show total statistical and the systematic uncertainties, combined in quadrature. The blue and brown colors show the theoretical predictions. The acceptances and the theoretical uncertainties in differential bins are computed using {\sc  powheg}. Sub-dominant production contributions XH $=$ VBF $+$ VH $+$ $\ensuremath  {t\bar {t}{\rm  H}}$ are shown in green separately. The inclusive cross section is normalized to SM estimates calculated at NNLL+NNLO level of accuracy for all theoretical predictions. The systematic uncertainties correspond to the generators accuracy are also taken in to account for differential predictions. The fraction of $4\mu $, $4e$ and $2e2\mu $ in each differential bin is allowed to float in fit. \relax }}{121}{figure.caption.347}}
\newlabel{fig:differential-results}{{6.27}{121}{Differential fiducial cross section results for $\pt ({\rm H})$ (top left), $|y({\rm H})|$ (top right), $p_T$ of leading jet (bottom left) and N(jets) (bottom right) in $\Hllll $ using full Run 2 CMS data and comparison with the theoretical predictions. Systematic uncertainty is indicated by red bars and black bars show total statistical and the systematic uncertainties, combined in quadrature. The blue and brown colors show the theoretical predictions. The acceptances and the theoretical uncertainties in differential bins are computed using {\sc powheg}. Sub-dominant production contributions XH $=$ VBF $+$ VH $+$ $\ttH $ are shown in green separately. The inclusive cross section is normalized to SM estimates calculated at NNLL+NNLO level of accuracy for all theoretical predictions. The systematic uncertainties correspond to the generators accuracy are also taken in to account for differential predictions. The fraction of $4\mu $, $4e$ and $2e2\mu $ in each differential bin is allowed to float in fit. \relax }{figure.caption.347}{}}
\@writefile{lof}{\contentsline {subfigure}{\numberline{(a)}{\ignorespaces {$\ensuremath {p_T}(\mathrm {H})$}}}{121}{figure.caption.347}}
