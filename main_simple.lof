\contentsline {figure}{\numberline {1.1}{\ignorespaces CFEB (Phase-1) and DCFEB (Phase-2) event loss fractions for HL-LHC conditions in the inner CSC rings ME2/1, ME3/1, and ME4/1 as a function of instantaneous luminosity. The design HL-LHC luminosity is marked by the dashed brown vertical line. \relax }}{3}{figure.caption.11}
\contentsline {figure}{\numberline {1.2}{\ignorespaces One of the DCFEB used for ME1/1. \relax }}{3}{figure.caption.12}
\contentsline {figure}{\numberline {1.3}{\ignorespaces The Spartan-6 ALCT mezzanine boards produced for the ME1/1 upgrade which will be around $104 mm \times 140 mm$ to accommodate the new optical components. \relax }}{4}{figure.caption.14}
\contentsline {figure}{\numberline {1.4}{\ignorespaces Bottom side of one of the OTMB mezzanine boards produced for the ME1/1 upgrade. The OTMB mezzanine is about $190 mm \times 134 mm$ in size. \relax }}{5}{figure.caption.16}
\contentsline {figure}{\numberline {1.5}{\ignorespaces Top side of one of the ODMBs produced for the ME1/1 upgrade. The ODMB is a 9U VME board, $400 mm \times 367 mm$ in size. The upgraded ODMB7 will be very similar to the ODMB, while the ODMB5 will have a different front panel configuration with copper connections to the five DCFEB(v2)s. \relax }}{6}{figure.caption.18}
\contentsline {figure}{\numberline {1.6}{\ignorespaces Simplified schematic of the current (left) and of the new (right) CSC electronics for the inner rings formed by ME2/1, ME3/1 and ME4/1. The orange lines mark optical data transfer, the blue lines represent copper cables.. \relax }}{8}{figure.caption.22}
