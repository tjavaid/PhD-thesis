\contentsline {figure}{\numberline {6.29}{\ignorespaces Left(Right): Inclusive cross section in differential final states at ATLAS (CMS) using an integrated luminosity of 139 $\ensuremath {\mathrm {fb^{-1}}}$ (137.1 $\ensuremath {\mathrm {fb^{-1}}}$). \relax }}{122}{figure.caption.362}
